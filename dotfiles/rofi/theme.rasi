* {
    /* Nord / Frosted Palette */
    bg-col:      rgba(46, 52, 64, 0.85);      /* nord0 - 85% translucent dark base */
    bg-col-light: rgba(59, 66, 82, 0.90);     /* nord1 - slightly lighter for input bar */
    border-col:  rgba(136, 192, 208, 0.8);    /* nord8 - Frost light blue border */
    selected-col: rgba(136, 192, 208, 0.25);  /* Soft highlight for selected item */
    blue:        #88c0d0;                     /* nord8 - Frost light blue accent */
    fg-col:      #eceff4;                     /* nord6 - Snow Storm crisp white */
    fg-col2:     #bf616a;                     /* nord11 - Aurora red */
    grey:        #4c566a;                     /* nord3 - Polar Night grey */

    background-color: transparent;
    text-color:       @fg-col;
    margin:           0;
    padding:          0;
}

window {
    height:           420px;
    width:            600px;
    border:           2px;
    border-color:     @border-col;
    background-color: @bg-col;
    border-radius:    12px;
    padding:          20px;
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, listview, mode-switcher ];
    spacing:          15px;
}

inputbar {
    children:         [ prompt, entry ];
    background-color: @bg-col-light;
    border-radius:    8px;
    padding:          4px;
}

prompt {
    background-color: @blue;
    padding:          8px 14px;
    text-color:       #2e3440;
    border-radius:    6px;
    font-weight:      bold;
}

entry {
    padding:          8px 12px;
    text-color:       @fg-col;
    background-color: transparent;
    placeholder:      "Search...";
    placeholder-color: @grey;
}

listview {
    border:           0px;
    padding:          6px 0px;
    columns:          1;
    lines:            6;
    background-color: transparent;
    spacing:          6px;
}

element {
    padding:          8px 12px;
    background-color: transparent;
    text-color:       @fg-col;
    border-radius:    6px;
}

element-icon {
    size:             24px;
    margin:           0 12px 0 0;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}

element selected {
    background-color: @selected-col;
    text-color:       @blue;
    border:           1px;
    border-color:     @blue;
}

mode-switcher {
    spacing: 10px;
    background-color: transparent;
}

button {
    padding:          8px;
    background-color: @bg-col-light;
    text-color:       @grey;
    vertical-align:   0.5; 
    horizontal-align: 0.5;
    border-radius:    6px;
}

button selected {
    background-color: @blue;
    text-color:       #2e3440;
    font-weight:      bold;
}
