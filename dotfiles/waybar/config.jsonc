{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,

    // Module Placement
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "pulseaudio",
        "cpu",
        "memory",
        "tray"
    ],

    // Workspaces Configuration
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "on-click": "activate"
    },

    // Centered Clock & Date
    "clock": {
        "interval": 1,
        "format": "{:%I:%M %p  ·  %A, %b %d}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    // Audio / Volume
    "pulseaudio": {
        "format": "VOL: {volume}%",
        "format-muted": "MUTED",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },

    // CPU Usage
    "cpu": {
        "interval": 2,
        "format": "CPU: {usage}%",
        "tooltip": true
    },

    // Memory / RAM Usage
    "memory": {
        "interval": 2,
        "format": "RAM: {percentage}%",
        "tooltip-format": "Memory: {used:0.1f}GiB / {total:0.1f}GiB"
    },

    // System Tray
    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
