# -----------------------------------------------------------------------------
# Clean Nord Prompt: [Dir] (git-branch) ❯❯
# -----------------------------------------------------------------------------
parse_git_branch() {
    git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/ (\1)/'
}

# Nord Color Variables
NORD_DIR="\[\033[1;36m\]"      # Frost light cyan for directory
NORD_GIT="\[\033[1;33m\]"      # Yellow/Aurora for git branch
NORD_CHEV1="\[\033[0;34m\]"    # Muted Frost blue
NORD_CHEV2="\[\033[1;36m\]"    # Bright Frost cyan
RESET="\[\033[0m\]"

# Construct Prompt: directory -> git branch -> double chevron
PS1="${NORD_DIR}\w${NORD_GIT}\$(parse_git_branch) ${NORD_CHEV1}❯${NORD_CHEV2}❯${RESET} "

# Aliases
alias la='ls -A'
alias l='ls -CF'
alias c='clear'
alias grep='grep --color=auto'
